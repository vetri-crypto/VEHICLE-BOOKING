{
  "info": {
    "_postman_id": "ooase-vehicle-booking-system-collection",
    "name": "Online Vehicle Booking System API - OOASE MERN Stack",
    "description": "Complete Postman API Test Suite for Online Vehicle Booking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Walker\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"9876500000\",\n  \"password\": \"password123\",\n  \"address\": \"456 Tech Park, City\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@vehicle.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@vehicle.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/vehicles", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "vehicles"] }
          }
        },
        {
          "name": "Search & Filter Vehicles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/vehicles/search?category=Electric&fuelType=Electric",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "vehicles", "search"],
              "query": [
                { "key": "category", "value": "Electric" },
                { "key": "fuelType", "value": "Electric" }
              ]
            }
          }
        },
        {
          "name": "Check Vehicle Availability Date Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/vehicles/{{vehicle_id}}/availability?startDate=2026-10-10&endDate=2026-10-15",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "vehicles", "{{vehicle_id}}", "availability"],
              "query": [
                { "key": "startDate", "value": "2026-10-10" },
                { "key": "endDate", "value": "2026-10-15" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicle_id}}\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2026-11-05\",\n  \"pickupLocation\": \"Airport Terminal\",\n  \"dropLocation\": \"City Hotel\",\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/bookings/{{booking_id}}/cancel", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings", "{{booking_id}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/admin/dashboard", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "dashboard"] }
          }
        },
        {
          "name": "Admin Update Booking Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/admin/bookings/{{booking_id}}/status", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "bookings", "{{booking_id}}", "status"] }
          }
        },
        {
          "name": "Admin Reports",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/admin/reports", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "reports"] }
          }
        }
      ]
    }
  ]
}
